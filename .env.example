# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server-only production webhook used by api/leads.ts.
N8N_FRYSAIDE_WEBHOOK_URL=""
N8N_FRYSAIDE_WEBHOOK_TOKEN=""

# Vite: only the Pixel ID is public. NEVER prefix the access token with VITE_.
VITE_META_PIXEL_ID="2607151959787465"
# Server-only (configure in hosting environment before production).
META_PIXEL_ID="2607151959787465"
META_API_ACCESS_TOKEN=""
META_TEST_EVENT_CODE="TEST84559"
META_DRY_RUN="true"
# Production: META_DRY_RUN=false, omit META_TEST_EVENT_CODE.
